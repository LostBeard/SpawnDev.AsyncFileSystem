<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<CompressionEnabled>false</CompressionEnabled>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.3" />
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.2" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.2.2" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorUI" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SpawnDev.AsyncFileSystem\SpawnDev.AsyncFileSystem.csproj" />
	</ItemGroup>

</Project>
