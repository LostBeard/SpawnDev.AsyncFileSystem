<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<CompressionEnabled>false</CompressionEnabled>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<!-- No Microsoft.AspNetCore.Components.WebAssembly / SpawnDev.SpawnJS.Blazor: this app boots through SpawnJS +
		     RazorRenderer from main.classic.js, not through blazor.webassembly.js. Referencing the Blazor runtime makes
		     SpawnDev.SpawnJS.WebWorkers (2.2.3+) treat it as a Blazor app and skip main.classic.js, and index.html 404s. -->
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.4" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.2.2" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorUI" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SpawnDev.AsyncFileSystem\SpawnDev.AsyncFileSystem.csproj" />
	</ItemGroup>

</Project>
